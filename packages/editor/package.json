{
  "name": "@dsk/editor",
  "version": "0.1.0",
  "description": "MVP visual editor for DSK Visual Engine",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./style.css": "./dist/index.css"
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsup src/index.tsx --format esm,cjs --dts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dsk/components": "workspace:*",
    "@dsk/core": "workspace:*",
    "@dsk/react-renderer": "workspace:*",
    "@dsk/templates": "workspace:*",
    "immer": "^10.1.1",
    "lucide-react": "^1.70.0",
    "zustand": "^4.5.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "tsup": "^8.5.1",
    "typescript": "^5.7.2",
    "vite": "^5.4.2"
  }
}
